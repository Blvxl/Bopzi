{
  "name": "bopzi",
  "description": "Creative studio for Roblox thumbnails and game icons",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/build-helper.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:web": "next start",
    "cf:build": "opennextjs-cloudflare build && node scripts/trim-cf-assets.mjs",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "desktop": "electron .",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:package": "node scripts/prepare-desktop.mjs --arm64 && cd electron && electron-builder --config electron-builder.json --win nsis --arm64",
    "desktop:pack": "npm run build && node scripts/prepare-desktop.mjs --arm64 && cd electron && electron-builder --config electron-builder.json --win nsis --arm64",
    "desktop:pack:x64": "npm run build && node scripts/prepare-desktop.mjs --x64 && cd electron && electron-builder --config electron-builder.json --win nsis --x64",
    "typecheck": "tsc --noEmit",
    "release:publish": "node scripts/publish-release.mjs",
    "site:publish": "node scripts/publish-site.mjs",
    "helper": "node helper/bopzi-helper.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "konva": "^10.7.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "sharp": "^0.35.5",
    "simple-icons": "16.35.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "wrangler": "^4.156.0"
  },
  "main": "electron/main.cjs"
}
