# Optional settings; leave commented to use the defaults.
# Required for Bopzi account sign-in. Configure this before giving accounts to creators.
# Local development only: explicitly bypasses the Bopzi login screen when no auth server is configured.
# Never enable this in a release build.
# Local production only: enables local AI and export routes.
# BOPZI_LOCAL_CHATGPT=1
# BOPZI_CODEX=C:\path\to\codex.exe
# BOPZI_FFMPEG=C:\path\to\ffmpeg.exe
# BOPZI_FFPROBE=C:\path\to\ffprobe.exe
# BOPZI_MEDIA_DIR=C:\path\to\media
# BOPZI_SOUNDS_DIR=C:\path\to\sounds
# BOPZI_EXPORT_DIR=C:\path\to\exports

# Optional: support link and ads on the public pages (nothing shows while empty)
NEXT_PUBLIC_DONATE_URL=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Server only, never NEXT_PUBLIC: lets a signed-in person delete their own account. Set it as a host secret.
SUPABASE_SERVICE_ROLE_KEY=
