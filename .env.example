# Optional settings; leave commented to use the defaults.
# Public site address (login redirects use it). Set it on the host.
NEXT_PUBLIC_SITE_URL=

# Free accounts (Supabase). Both are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_SIGNIN=

# Server only, never NEXT_PUBLIC: lets a signed-in person delete their own account. Set it as a host secret.
SUPABASE_SERVICE_ROLE_KEY=
