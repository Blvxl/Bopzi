# Optional settings; leave commented to use the defaults.
# Public site address (login redirects use it). Set it on the host.
NEXT_PUBLIC_SITE_URL=

# Free accounts (Supabase). Both are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_SIGNIN=

# Server only, never NEXT_PUBLIC. Supabase now calls it the "secret key" (sb_secret_…, Project Settings > API Keys); the older service_role key works too.
# It lets the collector publish data and lets a signed-in person delete their own account. Set it as a host secret.
SUPABASE_SERVICE_ROLE_KEY=

# The public website reads published data files instead of a database. Point this at the Supabase Storage bucket the collector fills
# (<project url>/storage/v1/object/public/site). Set it where the site is built (Cloudflare) and rebuild. Leave empty on the computer
# that runs the collector.
NEXT_PUBLIC_DATA_URL=
